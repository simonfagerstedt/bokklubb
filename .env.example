# Copy this file to .env.local for local development and fill in the values
# from your Supabase project (Project Settings -> API).
# For production, set the same values as Cloudflare Worker secrets/vars
# (see SETUP.md) - never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Which club this build is: "book" (Bokcirkeln, the default) or "film"
# (Filmklubben). See src/club.ts.
NEXT_PUBLIC_CLUB=book

# Movie club only: TMDB "API Read Access Token" (themoviedb.org -> Settings
# -> API). In production it is a Worker secret on filmklubb, never in the repo.
TMDB_API_KEY=
